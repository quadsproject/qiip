# QUADS LLM Inference Proxy Configuration
# Environment-variable reference. The primary configuration format is now the
# modular YAML files in conf/ (see conf/*.yml.example); variables listed here
# override those YAML values. Copy to .env and adjust values only when you use
# the legacy env-file path.
# All keys use the INFERENCE_PROXY_ prefix with double-underscore nesting.
# Uvicorn owns the server bind address and port; configure them in its launcher.

# etcd
INFERENCE_PROXY_ETCD__ENDPOINTS=["http://localhost:2379"]
# INFERENCE_PROXY_ETCD__NODE_PREFIX=/nodes/
# Proxy-managed healthy node keys expire without successful health evidence.
# Keep this above 300 seconds and above three complete health-check intervals.
# INFERENCE_PROXY_ETCD__NODE_LEASE_TTL=600

# Routing
# Total attempts including the first request.
# INFERENCE_PROXY_ROUTING__MAX_ATTEMPTS=3
# INFERENCE_PROXY_ROUTING__TIMEOUT=30
# Secure defaults allow only localhost/loopback on port 8000. Existing
# deployments must set the GPU host suffixes and/or IP networks before upgrade.
# INFERENCE_PROXY_ROUTING__ALLOWED_ENDPOINT_HOSTS=["*.inference.example.com"]
# INFERENCE_PROXY_ROUTING__ALLOWED_ENDPOINT_NETWORKS=["10.0.1.0/24"]
# INFERENCE_PROXY_ROUTING__ALLOWED_ENDPOINT_PORTS=[8000]

# Proxy (httpx timeouts — tuned for LLM inference)
# INFERENCE_PROXY_PROXY__CONNECT_TIMEOUT=5.0
# INFERENCE_PROXY_PROXY__READ_TIMEOUT=120.0
# INFERENCE_PROXY_PROXY__WRITE_TIMEOUT=10.0
# INFERENCE_PROXY_PROXY__POOL_TIMEOUT=10.0
# INFERENCE_PROXY_PROXY__MAX_CONNECTIONS=100
# INFERENCE_PROXY_PROXY__MAX_KEEPALIVE_CONNECTIONS=20
# INFERENCE_PROXY_PROXY__KEEPALIVE_EXPIRY=30

# Resilience (circuit breakers, health probes)
# INFERENCE_PROXY_RESILIENCE__CIRCUIT_BREAKER_THRESHOLD=3
# INFERENCE_PROXY_RESILIENCE__HEALTH_CHECK_FAILURE_THRESHOLD=3
# INFERENCE_PROXY_RESILIENCE__HEALTH_CHECK_INTERVAL=30

# Logging
# INFERENCE_PROXY_LOGGING__JSON_OUTPUT=false
# One of DEBUG, INFO, WARNING, ERROR, or CRITICAL. Invalid values fail startup.
# INFERENCE_PROXY_LOGGING__LEVEL=INFO

# Admin authentication (required)
# Set both values before startup. HTTP Basic sends credentials on every admin
# request. Use TLS when the network between clients and the gateway is not
# trusted.
# INFERENCE_PROXY_ADMIN__USERNAME=operator
# INFERENCE_PROXY_ADMIN__PASSWORD=

# User authentication, sessions, and API tokens (AUTH-01..AUTH-04)
# SQLite database backing the user/token/usage store.
# INFERENCE_PROXY_AUTH__DB_PATH=data/qiip.db
# Secret that signs the browser session cookie. REQUIRED for browser
# sign-in: both Google OAuth (transient state) and the local-admin form use
# the signed session cookie, so without it the UI cannot authenticate
# (HTTP Basic still works for scripts).
# INFERENCE_PROXY_AUTH__SESSION_SECRET=
# INFERENCE_PROXY_AUTH__SESSION_COOKIE=qiip_session
# INFERENCE_PROXY_AUTH__SESSION_TTL_SECONDS=43200
# Require /v1 inference requests to carry a valid bearer token. Defaults to
# false so existing public deployments keep working; requires OAuth enabled.
# INFERENCE_PROXY_AUTH__ENFORCE_API_TOKENS=false
# Reject Google accounts that have not verified their email address.
# INFERENCE_PROXY_AUTH__REQUIRE_EMAIL_VERIFICATION=true
# SSO whitelist: gate who can mint/use inference tokens.
# URL must be HTTPS and return a per-domain JSON document, e.g.
# {"example.com": ["alice", "bob"]}; the URL and enforcement flag must be
# set together (fail-fast); fetch timeout 5/10s, no redirects, 1 MiB cap.
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_URL=https://allowlist.example.com/users.json
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_DEFAULT_DOMAIN=example.com
# INFERENCE_PROXY_AUTH__ENFORCE_SSO_WHITELIST=false
# Polling: hourly (top of the hour) or daily at an HH:MM wall-clock time in
# the server's local timezone. Daily requires POLL_TIME.
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_POLL_INTERVAL=hourly
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_POLL_TIME=05:00
# Optional flat-file cache: persists the last successful document for warm
# start and operator inspection; atomically replaced on each refresh.
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_CACHE_FILE=/var/lib/qiip/sso-whitelist.json
# Local overrides merged on top of the fetched document: specific emails and
# catch-all domains granted without touching the remote payload.
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_EXTRA_USERS=["carol@example.com"]
# INFERENCE_PROXY_AUTH__SSO_WHITELIST_EXTRA_DOMAINS=["lab.example.com"]
# Emails whose tokens are exempt from endpoint scoping and owner isolation
# (and from the SSO whitelist gate); they may pin tokens to any endpoint.
# INFERENCE_PROXY_AUTH__ADMIN_ONLY_TOKENS_FULL_ACCESS=["ops@example.com"]

# Google OAuth (set all three credentials to enable)
# Set up an OAuth 2.0 client at https://console.cloud.google.com/apis/credentials.
# The redirect URI must be registered there and match this value exactly.
# INFERENCE_PROXY_OAUTH__CLIENT_ID=xxxxx.apps.googleusercontent.com
# INFERENCE_PROXY_OAUTH__CLIENT_SECRET=
# INFERENCE_PROXY_OAUTH__REDIRECT_URI=https://proxy.example.com/auth/callback
# Optional allowlist of Google Workspace hosted domains; empty allows any
# Google account.
# INFERENCE_PROXY_OAUTH__ALLOWED_DOMAINS=[]
# Extra hosts whose Host header is trusted for the OAuth callback redirect
# (multi-name deployments); the configured host is always trusted. Empty
# uses the configured REDIRECT_URI unchanged.
# INFERENCE_PROXY_OAUTH__ALLOWED_REDIRECT_HOSTS=[]

# Plugins
# Optional directory scanned for external (downstream/third-party) plugins.
# Module code executes at startup as the service user; point at a
# root/user-owned directory that is not group/world-writable.
# INFERENCE_PROXY_PLUGINS__EXTERNAL_DIR=/etc/qiip/plugins
# Fully-qualified plugin names that are never loaded.
# INFERENCE_PROXY_PLUGINS__DISABLED=["auth.google"]
# Per-plugin configuration keyed by plugin name.
# INFERENCE_PROXY_PLUGINS__CONFIG={"myplugin":{"api_key":"..."}}

# Dashboard
# INFERENCE_PROXY_DASHBOARD__POLL_INTERVAL=10

# Premium-equivalent pricing for token budget estimates (token dashboards)
# Rates are USD per million tokens. Defaults track Anthropic Claude Opus-class
# 1M-context pricing; the estimate is what the recorded usage would have cost
# at this rate, not a cash ledger.
# INFERENCE_PROXY_PRICING__INPUT_RATE_PER_MTOK=5.0
# INFERENCE_PROXY_PRICING__OUTPUT_RATE_PER_MTOK=25.0
# INFERENCE_PROXY_PRICING__MODEL_LABEL=claude-opus-4.8

# SSH (node provisioning access)
# INFERENCE_PROXY_SSH__KEY_PATH=~/.ssh/id_rsa
# INFERENCE_PROXY_SSH__USERNAME=root
# INFERENCE_PROXY_SSH__CONNECT_TIMEOUT=10
# INFERENCE_PROXY_SSH__STREAMING_COMMAND_TIMEOUT=3600
# INFERENCE_PROXY_SSH__STREAMING_INACTIVITY_TIMEOUT=900

# Provisioning
# INFERENCE_PROXY_PROVISIONING__HEALTH_POLL_TIMEOUT=600
# INFERENCE_PROXY_PROVISIONING__HEALTH_POLL_INTERVAL=10
# INFERENCE_PROXY_PROVISIONING__VLLM_PORT=8000
# INFERENCE_PROXY_PROVISIONING__MIN_DISK_GB=20
# INFERENCE_PROXY_PROVISIONING__DRAIN_TIMEOUT=30
# INFERENCE_PROXY_PROVISIONING__SCRIPTS_DIR=auto-vllm
# INFERENCE_PROXY_PROVISIONING__BOOT_WAIT_TIMEOUT=300
# INFERENCE_PROXY_PROVISIONING__BOOT_WAIT_INTERVAL=10
# INFERENCE_PROXY_PROVISIONING__MAX_CONCURRENT_PROVISIONS=32
# INFERENCE_PROXY_PROVISIONING__LOG_MAX_ENTRIES_PER_HOST=1000
# INFERENCE_PROXY_PROVISIONING__LOG_MAX_BYTES_PER_HOST=1048576
# INFERENCE_PROXY_PROVISIONING__LOG_MAX_ENTRY_BYTES=16384
# INFERENCE_PROXY_PROVISIONING__LOG_MAX_COMPLETED_HOSTS=64
# Durable gateway attempt history. Keep the DB on persistent local storage.
# INFERENCE_PROXY_PROVISIONING__LOG_DB_PATH=data/provisioning-logs.sqlite3
# INFERENCE_PROXY_PROVISIONING__LOG_RETENTION_DAYS=30
# INFERENCE_PROXY_PROVISIONING__LOG_STORAGE_MAX_BYTES=268435456
# INFERENCE_PROXY_PROVISIONING__LOG_ATTEMPT_MAX_BYTES=33554432
# INFERENCE_PROXY_PROVISIONING__LOG_MAX_ATTEMPTS=1000
# Node budget is split evenly between recorded payloads and bounded raw tails.
# INFERENCE_PROXY_PROVISIONING__LOG_REMOTE_ROOT=/var/lib/qiip/provisioning-logs
# INFERENCE_PROXY_PROVISIONING__LOG_REMOTE_RETENTION_DAYS=7
# INFERENCE_PROXY_PROVISIONING__LOG_REMOTE_MAX_BYTES=134217728
# INFERENCE_PROXY_PROVISIONING__LOG_REMOTE_ATTEMPT_MAX_BYTES=16777216
# INFERENCE_PROXY_PROVISIONING__LOG_REMOTE_MAX_ATTEMPTS=32
# INFERENCE_PROXY_PROVISIONING__LOG_RECONNECT_ATTEMPTS=3
# INFERENCE_PROXY_PROVISIONING__LOG_POLL_INTERVAL=1
# INFERENCE_PROXY_PROVISIONING__NFS_MOUNT_POINT=/srv/hf-cache
# INFERENCE_PROXY_PROVISIONING__NVIDIA_DRIVER_VERSION=580.126.09
# INFERENCE_PROXY_PROVISIONING__NVIDIA_DRIVER_SHA256=4cac53e48f8adff661d47c8788ed24059a248c9fd8098ceafd088a498986ec26
# llama.cpp is compiled for the managed node's NVIDIA GPU from verified source.
# INFERENCE_PROXY_PROVISIONING__LLAMACPP_VERSION=v0.4.1
# INFERENCE_PROXY_PROVISIONING__LLAMACPP_SHA256=ef3d5b1907a391500ae11b5e61a8e2022e0deaac9790899cad9c4e02f03bfb9a
# INFERENCE_PROXY_PROVISIONING__LLAMACPP_SOURCE_URL=https://github.com/ggml-org/llama.cpp/archive/refs/tags/{version}.tar.gz
# INFERENCE_PROXY_PROVISIONING__LLAMACPP_SETUP_TIMEOUT=7200
# INFERENCE_PROXY_PROVISIONING__LLAMACPP_FIT_TARGET_MIB=512

# QUADS (set BASE_URL to enable integration)
# INFERENCE_PROXY_QUADS__BASE_URL=http://quads.example.com
# Required with BASE_URL: IANA timezone used by the QUADS server's local clock.
# INFERENCE_PROXY_QUADS__SERVER_TIMEZONE=America/New_York
# INFERENCE_PROXY_QUADS__TIMEOUT=10.0
# INFERENCE_PROXY_QUADS__POLL_INTERVAL=300
# INFERENCE_PROXY_QUADS__VERIFY_SSL=true
# INFERENCE_PROXY_QUADS__SCHEDULE_CHECK_INTERVAL=300
# INFERENCE_PROXY_QUADS__SCHEDULE_LOOKAHEAD_HOURS=24

# Automatic placement of catalog llama.cpp profiles on free single-GPU hosts.
# Needs QUADS. Enabled by default; set false to opt out.
# GET /admin/placement reports its state.
# INFERENCE_PROXY_PLACEMENT__ENABLED=true
# INFERENCE_PROXY_PLACEMENT__INTERVAL_SECONDS=300
# Relative weights per catalog profile id (JSON). Zero or absent: never placed.
# INFERENCE_PROXY_PLACEMENT__RATIOS={"qwen3.8-27b-24g":9,"qwen3.6-35b-a3b-24g":2,"muse-glimmer-30b-24g":2,"gemma-4-31b-24g":2}
# Free VRAM kept beyond each profile's measured requirement.
# INFERENCE_PROXY_PLACEMENT__RESERVE_MIB=256
# Attempts since the last successful provision, including one in flight.
# INFERENCE_PROXY_PLACEMENT__MAX_ATTEMPTS=3
# Base retry backoff; also how long a host whose launch was blocked sits out.
# INFERENCE_PROXY_PLACEMENT__RETRY_BACKOFF_SECONDS=900
# INFERENCE_PROXY_PLACEMENT__CLAIM_STALE_SECONDS=300
# INFERENCE_PROXY_PLACEMENT__MAX_CONCURRENT=2
# Only place a profile on GPU products it has been validated on.
# INFERENCE_PROXY_PLACEMENT__REQUIRE_QUALIFIED_GPU=true
# Hosts automatic placement never touches (JSON list).
# INFERENCE_PROXY_PLACEMENT__EXCLUDE_HOSTS=[]
# When not empty, the only hosts it may touch (staged rollout; JSON list).
# INFERENCE_PROXY_PLACEMENT__ONLY_HOSTS=[]

# LLMFit (model recommendation via SSH)
# INFERENCE_PROXY_LLMFIT__BINARY_PATH=/usr/local/bin/llmfit
# INFERENCE_PROXY_LLMFIT__TIMEOUT=60.0
# INFERENCE_PROXY_LLMFIT__ALLOWED_PROVIDERS=["Meta","Mistral","DeepSeek","Google","Microsoft","MiniMax","Moonshot","Nomic","OpenAI"]
# INFERENCE_PROXY_LLMFIT__VERSION=1.1.6
# INFERENCE_PROXY_LLMFIT__SHA256=1e09232a128455596a2d348ab5893741d04b94aa6d924f1253462dc13304f7c6
# INFERENCE_PROXY_LLMFIT__INSTALL_URL=https://github.com/AlexsJones/llmfit/releases/download/v{version}/llmfit-v{version}-x86_64-unknown-linux-musl.tar.gz

# HuggingFace (cache_dir is required; export paths are required only for setup)
INFERENCE_PROXY_HUGGINGFACE__CACHE_DIR=/data/huggingface
# INFERENCE_PROXY_HUGGINGFACE__NFS_EXPORT=storage.example.com:/exports/huggingface
# INFERENCE_PROXY_HUGGINGFACE__SHARED_ROOT=/data
# INFERENCE_PROXY_HUGGINGFACE__API_TOKEN=hf_...

# Redfish BMC (set both credentials to enable power management)
# Node DNS names must also match ROUTING__ALLOWED_ENDPOINT_HOSTS. IP literals
# are not accepted for BMC template expansion.
# INFERENCE_PROXY_REDFISH__BMC_USERNAME=admin
# INFERENCE_PROXY_REDFISH__BMC_PASSWORD=password
# INFERENCE_PROXY_REDFISH__BMC_HOST_TEMPLATE=mgmt-{hostname}
# INFERENCE_PROXY_REDFISH__SYSTEM_ID=1
# INFERENCE_PROXY_REDFISH__CONNECT_TIMEOUT=10.0
# INFERENCE_PROXY_REDFISH__READ_TIMEOUT=60.0
# INFERENCE_PROXY_REDFISH__POWER_POLL_TIMEOUT=60.0
# INFERENCE_PROXY_REDFISH__POWER_POLL_INTERVAL=5.0
# INFERENCE_PROXY_REDFISH__VERIFY_SSL=false
