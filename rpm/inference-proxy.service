# QIIP inference proxy gateway service (RPM install).
#
# RPM layout (different from the git-checkout unit at systemd/inference-proxy.service):
#   /usr/share/qiip            node-side engine bundles (read-only)
#   /etc/qiip/conf             INFERENCE_PROXY_* YAML config (copied from *.example)
#   /etc/qiip/qiip.env         INFERENCE_PROXY_* overrides + server tuning knobs
#   /var/lib/qiip              writable SQLite data
#
# QUADS-style serving: the ASGI app runs as a tuned uvicorn worker farm
# (uvicorn dropped its bundled gunicorn worker, so gunicorn is not used),
# and nginx (also pulled in by the RPM) terminates TLS in front of the
# gateway. Tuning comes from the ``server:`` YAML block (or
# INFERENCE_PROXY_SERVER__* overrides), like every other QIIP setting.
#
# Runs as root like the stage deployment (provisioning SSH keys live under
# /root/.ssh); tighten this if the deployment does not provision nodes.

[Unit]
Description=QIIP inference proxy gateway
Documentation=https://github.com/quadsproject/qiip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/share/qiip
# `-` prefix: a missing env file is not fatal (systemd).
EnvironmentFile=-/etc/qiip/qiip.env
Environment=INFERENCE_PROXY_CONF_DIR=/etc/qiip/conf
Environment=INFERENCE_PROXY_PROVISIONING__LOG_DB_PATH=/var/lib/qiip/provisioning-logs.sqlite3
Environment=INFERENCE_PROXY_AUTH__DB_PATH=/var/lib/qiip/qiip.db
# Server tuning is resolved from the config by the launcher below, so the
# unit needs no tuning values; override with e.g.
# INFERENCE_PROXY_SERVER__WORKERS=2 in /etc/qiip/qiip.env or the YAML file.
ExecStart=/usr/bin/python3 -m inference_proxy.serve
Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
