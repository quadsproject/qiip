# QIIP plugin loading configuration. Copy to conf/plugins.yml in the working
# directory (or the directory named by INFERENCE_PROXY_CONF_DIR).
# This maps 1:1 onto the settings.plugins model used by PluginManager:
# external_dir (where external plugins are scanned), disabled (names never
# imported), and config (per-plugin config dicts). Per-plugin `enabled` is
# read by BasePlugin from the plugin's own config entry; omit it to default
# to enabled. Do not use ${ENV_VAR} placeholders here: the loader does not
# expand them, and environment variables override these values anyway.

plugins:
  # Optional directory scanned for external (downstream/third-party) plugins.
  # Module code executes at startup as the service user; point at a
  # root/user-owned directory that is not group/world-writable. Only
  # `disabled` below prevents a module from being imported at all.
  external_dir: null
  # Fully-qualified plugin names that are never loaded (never imported).
  # Add e.g. auth.google here only when replacing the built-in with an
  # external plugin registered under a distinct name.
  disabled: []
  # Per-plugin configuration keyed by plugin name, passed to the plugin
  # constructor.
  config:
    auth.google:
      enabled: true
    # Opt-in local OIDC provider (test/dev auth, or small local installs).
    # Off by default: with this block absent/disabled the sign-in page shows
    # only Local Admin and Google Auth. To enable, set enabled: true and the
    # provider discovery URL, and configure INFERENCE_PROXY_OAUTH__CLIENT_ID
    # / CLIENT_SECRET / REDIRECT_URI (the same triple Google uses).
    auth.internal_oidc:
      enabled: false
      # server_metadata_url: https://<host>/oidc/.well-known/openid-configuration
      # Local Login form (sign-in page replaces the Local Admin form with
      # "Local Login" when this provider is enabled):
      #   - the configured admin username/password is checked first and wins
      #   - any other username/password is checked against users_file (same
      #     format as the toy provider's users.txt; entries whose username is
      #     the admin username are ignored)
      # users_file: /etc/qiip/oidc-users.txt
      # The email suffix for bare usernames comes from the provider's
      # discovery document ("user_email_domain", published by the vendored
      # provider from OIDC_DOMAIN) so the form and the OIDC flow agree;
      # there is no per-plugin domain setting. Providers that advertise no
      # such claim map bare usernames to the default localdomain.
