# QIIP inference proxy gateway service.
#
# Deployed unit: /etc/systemd/system/inference-proxy.service
#
# Layout assumed (matches the stage/dev deployment convention):
#   /opt/inference-proxy                  repo checkout (uv sync'ed)
#   /opt/inference-proxy/.env             INFERENCE_PROXY_* settings
#   /opt/inference-proxy/.venv            uv-managed virtualenv
#
# The gateway listens on port 5000; nginx terminates TLS and proxies to it.
# Uvicorn's --reload is intentionally omitted: the service manager restarts.
# Runs as root like the stage deployment (provisioning SSH keys live under
# /root/.ssh); tighten this if the deployment does not provision nodes.

[Unit]
Description=QIIP inference proxy gateway
Documentation=https://github.com/quadsproject/qiip
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/inference-proxy
EnvironmentFile=/opt/inference-proxy/.env
ExecStart=/opt/inference-proxy/.venv/bin/uvicorn inference_proxy.main:create_app --factory --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
